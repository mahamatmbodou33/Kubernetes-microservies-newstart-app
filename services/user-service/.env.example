# User Service configuration (development defaults)
NODE_ENV=development
PORT=3000
SERVICE_NAME=user-service
LOG_LEVEL=info

# PostgreSQL connection (this service owns the newstart_users database)
DATABASE_URL=postgres://newstart:newstart_dev_password@localhost:5432/newstart_users

# Comma-separated CORS allow-list
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# Request body size limit
BODY_LIMIT=100kb

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

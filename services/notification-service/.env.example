# Notification Service configuration (development defaults)
NODE_ENV=development
PORT=3003
SERVICE_NAME=notification-service
LOG_LEVEL=info

# PostgreSQL connection (this service owns the newstart_notifications database)
DATABASE_URL=postgres://newstart:newstart_dev_password@localhost:5432/newstart_notifications

# Background worker
WORKER_ENABLED=true
QUEUE_POLL_INTERVAL_MS=2000
QUEUE_BATCH_SIZE=10
QUEUE_MAX_ATTEMPTS=5
# Use FOR UPDATE SKIP LOCKED for replica-safe claiming (requires real PostgreSQL).
QUEUE_SKIP_LOCKED=true

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
BODY_LIMIT=100kb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600

{
  "name": "@newstart/notification-service",
  "version": "0.1.0",
  "private": true,
  "description": "NewStart Notification Service — worker-based event processing and notifications.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "migrate:create": "node-pg-migrate create -j js"
  },
  "dependencies": {
    "@newstart/shared-events": "0.1.0",
    "@newstart/shared-types": "0.1.0",
    "@newstart/shared-utils": "0.1.0",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "glob": "^11.0.4",
    "helmet": "^8.0.0",
    "node-pg-migrate": "^7.6.1",
    "pg": "^8.13.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.7",
    "pg-mem": "^3.0.5",
    "supertest": "^7.0.0",
    "tsx": "^4.19.1"
  }
}

# Checklist Service configuration (development defaults)
NODE_ENV=development
PORT=3002
SERVICE_NAME=checklist-service
LOG_LEVEL=info

# PostgreSQL connection (this service owns the newstart_checklists database)
DATABASE_URL=postgres://newstart:newstart_dev_password@localhost:5432/newstart_checklists

# Notification Service — where task events are published (blank disables publishing)
NOTIFICATION_SERVICE_URL=http://localhost:3003
HTTP_TIMEOUT_MS=3000

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
BODY_LIMIT=100kb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# Opportunity Service configuration (development defaults)
NODE_ENV=development
PORT=3001
SERVICE_NAME=opportunity-service
LOG_LEVEL=info

# PostgreSQL connection (this service owns the newstart_opportunities database)
DATABASE_URL=postgres://newstart:newstart_dev_password@localhost:5432/newstart_opportunities

# Service discovery — used to fetch a user's skills for recommendations
USER_SERVICE_URL=http://localhost:3000
# Where OPPORTUNITY_SAVED events are published (blank disables publishing)
NOTIFICATION_SERVICE_URL=http://localhost:3003
HTTP_TIMEOUT_MS=5000

# Comma-separated CORS allow-list
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

BODY_LIMIT=100kb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

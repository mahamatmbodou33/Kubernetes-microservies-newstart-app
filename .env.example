# =============================================================================
# NewStart — root environment example
# Copy to `.env` for docker-compose. Each service also has its own .env.example.
# NEVER commit a real .env file. No secrets belong in source control.
# =============================================================================

# ---- PostgreSQL (shared instance, one database per service) ----
POSTGRES_USER=newstart
POSTGRES_PASSWORD=newstart_dev_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Per-service databases (created by scripts/init-databases.sql)
USER_DB_NAME=newstart_users
OPPORTUNITY_DB_NAME=newstart_opportunities
CHECKLIST_DB_NAME=newstart_checklists
NOTIFICATION_DB_NAME=newstart_notifications

# ---- Service ports ----
USER_SERVICE_PORT=3000
OPPORTUNITY_SERVICE_PORT=3001
CHECKLIST_SERVICE_PORT=3002
NOTIFICATION_SERVICE_PORT=3003
GATEWAY_PORT=8080

# ---- Service discovery (use container/service names in compose & K8s) ----
USER_SERVICE_URL=http://user-service:3000
OPPORTUNITY_SERVICE_URL=http://opportunity-service:3001
CHECKLIST_SERVICE_URL=http://checklist-service:3002
NOTIFICATION_SERVICE_URL=http://notification-service:3003

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8080

# ---- Cross-cutting ----
LOG_LEVEL=info
NODE_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
